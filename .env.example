# Public browser configuration. Never put service-role or AI provider keys here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional independent backend implementing docs/ai-backend.md. No provider key.
VITE_AI_ENDPOINT=

# Normally / locally. The deployment workflow sets the repository Pages path.
VITE_BASE_PATH=/
